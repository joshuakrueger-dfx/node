# ZK402 local test environment — the REAL env vars the zkCoins node reads.
# (operations/env.example in the spec repo targets a separate publisher
#  service; THIS file matches node/src/lib.rs.)
# Copy to .env; seed.sh generates the two keys on first run if absent.

IS_MAINNET=false
DATABASE_URL=postgres://zk402:zk402@postgres:5432/zk402
USERNAME_DOMAIN=zk402.local
ZKCOINS_SKIP_BOOTSTRAP_WARMUP=1
RUST_LOG=info

# Generated by seed.sh (openssl rand -hex 32 / Ed25519 PKCS8 base64url):
PUBLISHER_KEY=
ZK402_RECEIPT_KEY=

# Esplora — overridden per compose profile (offline → stub, mutinynet → real).
ESPLORA_URL=http://esplora-stub:3002
ESPLORA_WS_URL=ws://esplora-stub:3002/api/v1/ws
